<!-- gaitos: flat ground scene for the r1 with Dex3-1 hands (r1_dex3.xml, generated at build time) (BSD-3-Clause) -->
<mujoco model="r1 scene">
  <include file="r1_dex3.xml"/>

  <statistic center="0 0 0.3" extent="1.0"/>

  <visual>
    <headlight diffuse="0.45 0.45 0.45" ambient="0.25 0.25 0.27" specular="0.15 0.15 0.15"/>
    <quality shadowsize="4096"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
      rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
      reflectance="0.2"/>
  </asset>

  <worldbody>
    <!-- top light (the only shadow: oblique ones alias over a large world), key light from the
         front left for the highlights of the glossy shells, soft fill from behind -->
    <light name="top" pos="0 0 3.5" dir="0 0 -1" directional="true" diffuse="0.45 0.45 0.45"
      specular="0.2 0.2 0.2"/>
    <light name="key" pos="2 1.5 4" dir="-0.45 -0.35 -0.82" directional="true" diffuse="0.35 0.35 0.34"
      specular="0.35 0.35 0.35" castshadow="false"/>
    <light name="fill" pos="-2 -1 3" dir="0.5 0.25 -0.83" directional="true" diffuse="0.18 0.19 0.22"
      specular="0.1 0.1 0.1" castshadow="false"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" friction="1 0.02 0.01"/>
  </worldbody>
</mujoco>
