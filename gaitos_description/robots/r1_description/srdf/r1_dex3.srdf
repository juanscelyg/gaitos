<?xml version="1.0"?>
<!--
  r1_dex3.srdf: r1.srdf for the R1 with Dex3-1 hands (urdf/r1_dex3.urdf, mjcf/r1_dex3.xml;
  model:=dex3 in the launch files). Only the stand pose changes: ankle pitch -0.28 instead of
  -0.3. The 1.4 kg of the hands move the centre of mass forward and, with the ankles sagging
  under their PD, the r1.srdf stand left the R1 on its toes (pelvis pitched 0.04 rad): it held
  in stand_up but tipped over in balance_stand. With -0.28 it stands on flat feet, slightly back
  (pitch -0.03), takes a forward arm of arm_sdk up to about -0.3 rad and still walks.
  Tested in MuJoCo: -0.29 holds balance_stand but falls with the arm at -0.3; -0.25 falls back.
-->
<!--
  gaitos SRDF of the Unitree R1 humanoid (URDF from unitree_ros, BSD-3-Clause).
  Joint order of the "all" group = R1 joint index of unitree_sdk2/example/r1 (legs, waist,
  arms, head). Poses: zero (straight, as spawned), stand (knees bent), squat (R1 FSM 2).
-->
<robot name="r1">
  <group name="left_leg">
    <chain base_link="pelvis_link" tip_link="left_ankle_roll_link"/>
  </group>
  <group name="right_leg">
    <chain base_link="pelvis_link" tip_link="right_ankle_roll_link"/>
  </group>
  <group name="legs">
    <group name="left_leg"/>
    <group name="right_leg"/>
  </group>
  <group name="waist">
    <joint name="waist_roll_joint"/>
    <joint name="waist_yaw_joint"/>
  </group>
  <group name="left_arm">
    <joint name="left_shoulder_pitch_joint"/>
    <joint name="left_shoulder_roll_joint"/>
    <joint name="left_shoulder_yaw_joint"/>
    <joint name="left_elbow_joint"/>
    <joint name="left_wrist_roll_joint"/>
  </group>
  <group name="right_arm">
    <joint name="right_shoulder_pitch_joint"/>
    <joint name="right_shoulder_roll_joint"/>
    <joint name="right_shoulder_yaw_joint"/>
    <joint name="right_elbow_joint"/>
    <joint name="right_wrist_roll_joint"/>
  </group>
  <group name="arms">
    <group name="left_arm"/>
    <group name="right_arm"/>
  </group>
  <group name="head">
    <joint name="head_pitch_joint"/>
    <joint name="head_yaw_joint"/>
  </group>
  <!-- The joints Unitree's arm_sdk drives over the walking controller (arm_control_routine) -->
  <group name="arm_sdk">
    <group name="arms"/>
    <joint name="waist_yaw_joint"/>
    <group name="head"/>
  </group>
  <group name="all">
    <group name="legs"/>
    <group name="waist"/>
    <group name="arms"/>
    <group name="head"/>
  </group>

  <!-- Named poses -->
  <group_state name="zero" group="all">
    <joint name="left_hip_pitch_joint" value="0.0"/>
    <joint name="left_hip_roll_joint" value="0.0"/>
    <joint name="left_hip_yaw_joint" value="0.0"/>
    <joint name="left_knee_joint" value="0.0"/>
    <joint name="left_ankle_pitch_joint" value="0.0"/>
    <joint name="left_ankle_roll_joint" value="0.0"/>
    <joint name="right_hip_pitch_joint" value="0.0"/>
    <joint name="right_hip_roll_joint" value="0.0"/>
    <joint name="right_hip_yaw_joint" value="0.0"/>
    <joint name="right_knee_joint" value="0.0"/>
    <joint name="right_ankle_pitch_joint" value="0.0"/>
    <joint name="right_ankle_roll_joint" value="0.0"/>
    <joint name="waist_roll_joint" value="0.0"/>
    <joint name="waist_yaw_joint" value="0.0"/>
    <joint name="left_shoulder_pitch_joint" value="0.0"/>
    <joint name="left_shoulder_roll_joint" value="0.0"/>
    <joint name="left_shoulder_yaw_joint" value="0.0"/>
    <joint name="left_elbow_joint" value="0.0"/>
    <joint name="left_wrist_roll_joint" value="0.0"/>
    <joint name="right_shoulder_pitch_joint" value="0.0"/>
    <joint name="right_shoulder_roll_joint" value="-0.0"/>
    <joint name="right_shoulder_yaw_joint" value="-0.0"/>
    <joint name="right_elbow_joint" value="0.0"/>
    <joint name="right_wrist_roll_joint" value="-0.0"/>
    <joint name="head_pitch_joint" value="0.0"/>
    <joint name="head_yaw_joint" value="0.0"/>
  </group_state>
  <group_state name="stand" group="all">
    <joint name="left_hip_pitch_joint" value="-0.3"/>
    <joint name="left_hip_roll_joint" value="0.0"/>
    <joint name="left_hip_yaw_joint" value="0.0"/>
    <joint name="left_knee_joint" value="0.6"/>
    <joint name="left_ankle_pitch_joint" value="-0.28"/>
    <joint name="left_ankle_roll_joint" value="0.0"/>
    <joint name="right_hip_pitch_joint" value="-0.3"/>
    <joint name="right_hip_roll_joint" value="0.0"/>
    <joint name="right_hip_yaw_joint" value="0.0"/>
    <joint name="right_knee_joint" value="0.6"/>
    <joint name="right_ankle_pitch_joint" value="-0.28"/>
    <joint name="right_ankle_roll_joint" value="0.0"/>
    <joint name="waist_roll_joint" value="0.0"/>
    <joint name="waist_yaw_joint" value="0.0"/>
    <joint name="left_shoulder_pitch_joint" value="0.2"/>
    <joint name="left_shoulder_roll_joint" value="0.2"/>
    <joint name="left_shoulder_yaw_joint" value="0.0"/>
    <joint name="left_elbow_joint" value="0.4"/>
    <joint name="left_wrist_roll_joint" value="0.0"/>
    <joint name="right_shoulder_pitch_joint" value="0.2"/>
    <joint name="right_shoulder_roll_joint" value="-0.2"/>
    <joint name="right_shoulder_yaw_joint" value="-0.0"/>
    <joint name="right_elbow_joint" value="0.4"/>
    <joint name="right_wrist_roll_joint" value="-0.0"/>
    <joint name="head_pitch_joint" value="0.0"/>
    <joint name="head_yaw_joint" value="0.0"/>
  </group_state>
  <group_state name="squat" group="all">
    <joint name="left_hip_pitch_joint" value="-0.8"/>
    <joint name="left_hip_roll_joint" value="0.0"/>
    <joint name="left_hip_yaw_joint" value="0.0"/>
    <joint name="left_knee_joint" value="1.6"/>
    <joint name="left_ankle_pitch_joint" value="-0.8"/>
    <joint name="left_ankle_roll_joint" value="0.0"/>
    <joint name="right_hip_pitch_joint" value="-0.8"/>
    <joint name="right_hip_roll_joint" value="0.0"/>
    <joint name="right_hip_yaw_joint" value="0.0"/>
    <joint name="right_knee_joint" value="1.6"/>
    <joint name="right_ankle_pitch_joint" value="-0.8"/>
    <joint name="right_ankle_roll_joint" value="0.0"/>
    <joint name="waist_roll_joint" value="0.0"/>
    <joint name="waist_yaw_joint" value="0.0"/>
    <joint name="left_shoulder_pitch_joint" value="0.4"/>
    <joint name="left_shoulder_roll_joint" value="0.2"/>
    <joint name="left_shoulder_yaw_joint" value="0.0"/>
    <joint name="left_elbow_joint" value="0.8"/>
    <joint name="left_wrist_roll_joint" value="0.0"/>
    <joint name="right_shoulder_pitch_joint" value="0.4"/>
    <joint name="right_shoulder_roll_joint" value="-0.2"/>
    <joint name="right_shoulder_yaw_joint" value="-0.0"/>
    <joint name="right_elbow_joint" value="0.8"/>
    <joint name="right_wrist_roll_joint" value="-0.0"/>
    <joint name="head_pitch_joint" value="0.0"/>
    <joint name="head_yaw_joint" value="0.0"/>
  </group_state>

  <end_effector name="left_foot" parent_link="left_ankle_roll_link" group="left_leg"/>
  <end_effector name="right_foot" parent_link="right_ankle_roll_link" group="right_leg"/>
</robot>
